{
 "_doc": "UD -> project relation conversion table (DATA), version 3. Translates another annotation scheme's relation names and structural conventions into the project's tree format; it holds NO words of any language. Rules are matched top to bottom, first match wins. Fields: name = traceability name carried by every converted link; ud = full or base (before ':') deprel, or an internal pseudo-relation made by an operation; dep_upos / head_upos = UPOS lists; dep_feat = 'Key=Val' in the dependent's FEATS. 'ops' are named structural operations applied in 'op_order'. v3 changes vs the feasibility v2: leading conjunction cannot coordinate later conjuncts (coord_lift.first_conjunct_precedes_cc); a leftover conjunction is COORDINATION; relative pronouns get the parser's label (see rules rel_pron_*). Relative-pronoun rules: the project's parser (gold v7) labels subject relative pronouns SUBJECT (who 1060/1511, which 472/759) and object ones OBJECT, so the pronoun is labelled by its role in the relative clause.",
 "op_order": [
  "drop_punct",
  "copula_swap",
  "phrase_head_swap",
  "coord_lift"
 ],
 "ops": {
  "drop_punct": {
   "upos": [
    "PUNCT"
   ],
   "note": "punctuation is not a node in the project format"
  },
  "copula_swap": {
   "marker_rel": "cop",
   "pseudo_rel": "pred",
   "move_to_copula_rels": [
    "nsubj",
    "csubj",
    "aux",
    "mark",
    "advcl",
    "expl",
    "discourse",
    "vocative",
    "parataxis",
    "cop",
    "dislocated",
    "orphan"
   ],
   "move_conj_if_conjunct_has_rel": [
    "nsubj",
    "csubj",
    "cop"
   ],
   "note": "predicate loses head role: the copula becomes head, takes the predicate's own place and relation, and receives its subject/aux/clausal dependents; the predicate becomes its child (label by predicate UPOS via the 'pred' rules)",
   "conj_rel": "conj"
  },
  "phrase_head_swap": [
   {
    "name": "adposition_heads_noun",
    "marker_rel": "case",
    "pseudo_rel": "case_obj",
    "bring_up_rels": [
     "cc"
    ],
    "bring_up_conj_if_conjunct_has_marker": true,
    "note": "case marker becomes head of the phrase and takes its relation to the outer head (chain if several); the old phrase head becomes its child",
    "conj_rel": "conj",
    "preconj_rel": "cc:preconj"
   },
   {
    "name": "subordinator_heads_clause",
    "marker_rel": "mark",
    "pseudo_rel": "in_mark",
    "bring_up_rels": [
     "cc"
    ],
    "bring_up_conj_if_conjunct_has_marker": true,
    "note": "mark becomes head of its clause; the clause head becomes its child",
    "conj_rel": "conj",
    "preconj_rel": "cc:preconj"
   }
  ],
  "coord_lift": {
   "conj_rel": "conj",
   "cc_rel": "cc",
   "pseudo_item": "coord_item",
   "pseudo_asyndeton": "coord_asyn",
   "note": "the first coordinator (cc) takes the place of the first conjunct in the tree; first conjunct and all conj dependents become its children. Without cc the later conjuncts hang under the first (asyndeton). A coordinator before the first conjunct is never chosen; it stays a child of that conjunct.",
   "preconj_rel": "cc:preconj",
   "coordinator_must_follow_first_conjunct": true
  }
 },
