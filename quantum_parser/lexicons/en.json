"doc": "Closed-class lexicon: serves the parser (tag/ambiguous/subtype) and USVS (readings.dims). dims weights in [0,1] over named USVS axes; j=true marks a judgment call (j_dims = which weights). Entries without readings are open-class words the parser table lists: they keep their WordNet placement.",
"structural_classes": {
 "ABSORBED_PREMOD": "bare modifier/determiner that sits immediately left of a verbal (or noun) and is absorbed into it; carries no arguments",
 "FRONT_LINKER": "clause-initial word that opens a clause containing a gap and attaches to the verbal/predicate that follows",
 "PREDICATE_FIRST": "flag stamped on a predicate that has no subject to its left (subject postposed); replaces QUESTION",
 "AUX_BARE_NEXT": "auxiliary that takes a bare verb as its complement",
 "AUX_PP_NEXT": "auxiliary that takes a past participle as its complement",
 "AUX_PART_NEXT": "auxiliary/copula that takes a participle or a complement; can be predicate-first",
 "NOUN_CLITIC_LEFT": "clitic that attaches to the noun on its left and heads a following noun phrase",
 "PRE_VERB_PARTICLE": "particle immediately before a bare verb",
 "PROMOTABLE_BARE": "determiner/specifier that, if unconsumed by ordinary attachment, is promoted to a standalone nominal",
 "INITIAL_PLACEHOLDER": "sentence-initial placeholder subject word immediately before a copula"
},
